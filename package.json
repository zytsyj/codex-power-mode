{
  "name": "codex-power-mode",
  "version": "0.8.0",
  "private": true,
  "description": "Reactive Power Mode effects for Codex",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/power-mode.mjs start --open",
    "native": "node scripts/power-mode.mjs native",
    "native:arcade": "CODEX_POWER_MODE_PRESET=arcade node scripts/power-mode.mjs native",
    "native:stop": "node scripts/power-mode.mjs native-stop",
    "stop": "node scripts/power-mode.mjs stop",
    "reset:settings": "node scripts/power-mode.mjs reset-settings",
    "purge:data": "node scripts/power-mode.mjs purge-data",
    "demo": "node scripts/power-mode.mjs demo",
    "showcase": "node scripts/power-mode.mjs showcase",
    "showcase:energy": "node scripts/power-mode.mjs energy-showcase",
    "replay": "node scripts/power-mode.mjs replay",
    "status": "node scripts/power-mode.mjs status",
    "doctor": "node scripts/power-mode.mjs doctor",
    "perf:rc": "node scripts/performance-rc.mjs --output .power-mode/performance-rc.json",
    "stability:rc": "node scripts/stability-rc.mjs --output .power-mode/stability-rc.json",
    "render:demos": "node scripts/render-demos.mjs --output .power-mode/render-demos",
    "render:qa": "node scripts/render-qa.mjs --output .power-mode/render-qa",
    "test": "node --test",
    "check": "node scripts/validate-manifest.mjs && node scripts/validate-release-hygiene.mjs && node --check hooks/session-start.mjs && node --check hooks/power-mode-hook.mjs && node --check scripts/server.mjs && node --check overlay/app.js && node --test"
  }
}
